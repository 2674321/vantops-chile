    "suncalc": "^1.9.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "@tailwindcss/vite": "^4.0.6",
    "@types/leaflet": "^1.9.22",
